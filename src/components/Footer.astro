---
import Icon from './Icon.astro';
import { REPO_URL, href } from '../lib/site';
import type { GuidedTrack } from '../lib/tracks';

interface Props {
  track?: GuidedTrack;
}

const { track } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap foot">
    <div class="foot__col">
      <p class="foot__name">Democritus Sec Team{track && <> <span>·</span> {track.name}</>}</p>
      <p class="foot__sub">Δημοκρίτειο Πανεπιστήμιο Θράκης</p>
    </div>
    <p class="foot__help">
      <Icon name="chat" size={17} />
      <span>Κόλλησες; Γράψε στο <strong class="mono">{track?.guide.channel ?? '#chat'}</strong> στο Discord της ομάδας.</span>
    </p>
    <ul class="foot__links">
      {track && <li><a href={href()}>Όλες οι ομάδες</a></li>}
      {track?.slug === 'blockchain' && <li><a href={href('blockchain/faq/')}>Πώς δουλεύουμε</a></li>}
      <li><a href={REPO_URL} rel="noopener">Κώδικας στο GitHub</a></li>
    </ul>
    <p class="foot__privacy">
      Χωρίς tracking και χωρίς λογαριασμό. Η πρόοδός σου μένει μόνο στον browser σου.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--border-soft);
    background: var(--surface);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .foot {
    display: grid;
    grid-template-columns: 1fr 1.4fr auto;
    gap: 16px 40px;
    padding-block: 32px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .foot__name {
    font-weight: 700;
    color: var(--ink);
  }
  .foot__name span {
    color: var(--ink-3);
  }
  .foot__sub {
    color: var(--ink-3);
  }
  .foot__help {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .foot__help :global(svg) {
    margin-top: 0.25em;
    flex: none;
    color: var(--blue-ink);
  }
  .foot__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .foot__privacy {
    grid-column: 1 / -1;
    padding-top: 16px;
    border-top: 1px solid var(--border-soft);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  @media (max-width: 760px) {
    .foot {
      grid-template-columns: 1fr;
    }
  }
</style>
