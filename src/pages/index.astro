---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Join from '../components/Join.astro';
import { href } from '../lib/site';
import { TRACKS } from '../lib/tracks';

const goals = [
  { title: 'Εκπαίδευση', text: 'Οδηγοί, υλικό και βοήθεια για όποιον ξεκινάει από το μηδέν.' },
  { title: 'Διαγωνισμοί CTF', text: 'Παίζουμε μαζί σε Capture The Flag και μαθαίνουμε από κάθε challenge.' },
  { title: 'Έρευνα', text: 'Ψάχνουμε σε βάθος τον χώρο της κυβερνοασφάλειας και μοιραζόμαστε ό,τι βρίσκουμε.' },
];

const steps = [
  {
    title: 'Βασικές γνώσεις',
    text: 'Ξεκίνα με το Junior Cybersecurity Analyst της Cisco Networking Academy. Είναι δωρεάν και σου δίνει τις βάσεις που χρειάζεσαι.',
    link: { href: 'https://www.netacad.com/career-paths/cybersecurity', label: 'Cisco: Junior Cybersecurity Analyst' },
  },
  {
    title: 'Στήσε το περιβάλλον σου',
    text: 'Θα χρειαστείς ένα Virtual Machine για να δουλεύεις με ασφάλεια. Στο Discord θα βρεις βίντεο που σε βοηθάει να το στήσεις βήμα βήμα.',
  },
  {
    title: 'Διάλεξε υποομάδα',
    text: 'Μόλις νιώσεις έτοιμος ή έτοιμη, διάλεξε τον τομέα που σε ενδιαφέρει. Στο Discord πήγαινε στο Channels & Roles και βάλε τον ρόλο της ομάδας σου. Αν δεν ξέρεις ακόμα τι σε ενδιαφέρει, ρώτα στο #chat.',
    link: { href: '#teams', label: 'Δες τις υποομάδες' },
  },
  {
    title: 'Πάρε πρόσβαση στο υλικό μας',
    text: 'Μίλησε με κάποιον team leader για να σου δώσει πρόσβαση στο shared drive, όπου μοιραζόμαστε όλο το υλικό μας και τη δουλειά που έχουμε κάνει ως τώρα.',
  },
  {
    title: 'Μπες στο GitHub μας',
    text: 'Στο GitHub μοιραζόμαστε εργαλεία και οργανώνουμε τις γνώσεις μας γι’ αυτά. Τα repositories είναι ανοιχτά σε όλους. Όταν μπεις σε ομάδα, ζήτα από τον team leader να σε κάνει μέλος, για να μπορείς και να τα εμπλουτίζεις.',
  },
];
---

<Base>
  <section class="hero wrap">
    <div class="hero__copy">
      <h1>Καλώς ήρθες στη Democritus Sec Team!</h1>
      <p class="hero__lead">Χαιρόμαστε που είσαι εδώ. Ρίξε μια ματιά παρακάτω για να μάθεις ποιοι είμαστε και πού ανήκεις.</p>
      <div class="hero__cta">
        <a class="btn" href="#teams">
          Διάλεξε υποομάδα
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--ghost" href="#first-steps">Πρώτα βήματα</a>
      </div>
      <p class="hero__note">Δεν χρειάζεσαι εμπειρία για να ξεκινήσεις, μόνο διάθεση να μάθεις.</p>
    </div>

    <section class="readme" id="about" aria-labelledby="about-title">
      <div class="readme__head">
        <span class="addr">README.md</span>
        <span class="addr">ΔΠΘ</span>
      </div>
      <div class="readme__body">
        <h2 id="about-title">Τι είναι η Democritus Sec Team;</h2>
        <p>
          Είμαστε η φοιτητική ομάδα κυβερνοασφάλειας του Δημοκρίτειου Πανεπιστημίου Θράκης, με υπεύθυνο καθηγητή τον Κωνσταντίνο
          Ράντο. Ο στόχος μας είναι τριπλός:
        </p>
        <ol class="goals">
          {
            goals.map((g, i) => (
              <li>
                <span class="addr goals__n">0{i + 1}</span>
                <span>
                  <strong>{g.title}</strong>
                  {g.text}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </section>

  <section class="teams wrap" id="teams" aria-labelledby="teams-title">
    <div class="sec-head">
      <h2 id="teams-title">Οι υποομάδες μας</h2>
      <p>
        Κάθε υποομάδα έχει τον δικό της τομέα. Διάλεξε αυτόν που σε τραβάει: λίγες ερωτήσεις σε στέλνουν στο σωστό σημείο του
        οδηγού της, ανάλογα με το τι ξέρεις ήδη.
      </p>
    </div>

    <ul class="teams__grid">
      {
        TRACKS.map((t) => (
          <li class:list={['team', { 'team--ready': t.guide }]}>
            <div class="team__head">
              <span class="addr team__handle">team/{t.handle}</span>
              {t.guide ? (
                <span class="team__status team__status--ready">
                  <Icon name="check" size={13} /> οδηγός
                </span>
              ) : (
                <span class="team__status">οδηγός σύντομα</span>
              )}
            </div>
            <div class="team__body">
              <h3 class="team__name">{t.name}</h3>
              {t.summary.map((p) => (
                <p class="team__text">{p}</p>
              ))}
              <div class="team__foot">
                {t.guide ? (
                  <>
                    <a class="btn" href={href(`${t.slug}/start/`)}>
                      Από πού ξεκινάω;
                      <Icon name="arrow-right" size={18} />
                    </a>
                    <a class="team__more" href={href(`${t.slug}/`)}>
                      Δες τον οδηγό
                    </a>
                  </>
                ) : (
                  <p class="team__soon">
                    Ο οδηγός ετοιμάζεται. Μέχρι τότε ρώτα στο <strong class="mono">#chat</strong> στο Discord.
                  </p>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="first wrap" id="first-steps" aria-labelledby="first-title">
    <div class="sec-head">
      <h2 id="first-title">Πρώτα βήματα</h2>
      <p>
        Αν δεν ξέρεις από πού να ξεκινήσεις, μην ανησυχείς: όλοι ξεκινήσαμε από το μηδέν. Ό,τι βοήθεια χρειαστείς, είμαστε δίπλα
        σου.
      </p>
    </div>

    <div class="first__grid">
      <ol class="path">
        {
          steps.map((s, i) => (
            <li class="path__step">
              <span class="addr path__n">Βήμα {i + 1}</span>
              <div class="path__body">
                <h3 class="path__title">{s.title}</h3>
                <p class="path__text">{s.text}</p>
                {s.link &&
                  (s.link.href.startsWith('#') ? (
                    <a class="path__link" href={s.link.href}>
                      {s.link.label} <Icon name="arrow-right" size={15} />
                    </a>
                  ) : (
                    <a class="path__link" href={s.link.href} target="_blank" rel="noopener noreferrer">
                      {s.link.label} <Icon name="external" size={15} />
                      <span class="visually-hidden">(ανοίγει σε νέα καρτέλα)</span>
                    </a>
                  ))}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="first__side">
        <Join />
        <aside class="callout callout--note bigmap" aria-label="Γενικό roadmap">
          <Icon name="info" size={20} />
          <div>
            <p><strong>Θες τη μεγάλη εικόνα;</strong></p>
            <p>
              Το <a href="https://roadmap.sh/cyber-security" target="_blank" rel="noopener noreferrer">Cyber Security Roadmap του roadmap.sh</a>{' '}
              δείχνει όλο τον χώρο βήμα βήμα, για να δεις πού κολλάει η κάθε υποομάδα.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px 72px;
    align-items: center;
    padding-block: clamp(40px, 7vw, 88px) 56px;
  }
  .hero__copy {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 1.3rem + 3.6vw, 3.6rem);
    max-width: 14ch;
  }
  .hero__lead {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 46ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .hero__note {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .readme {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .readme__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 16px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border-soft);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .readme__head .addr:first-child {
    color: var(--ink);
    font-weight: 700;
  }
  .readme__body {
    display: grid;
    gap: 14px;
    padding: 20px 22px 22px;
  }
  .readme__body h2 {
    font-size: 1.35rem;
  }
  .readme__body > p {
    color: var(--ink-2);
  }
  .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px dashed var(--border);
  }
  .goals li {
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr);
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px dashed var(--border);
    color: var(--ink-2);
  }
  .goals li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .goals strong {
    display: block;
    color: var(--ink);
  }
  .goals__n {
    padding-top: 0.15em;
    font-weight: 700;
    color: var(--green-ink);
  }

  .sec-head {
    display: grid;
    gap: 10px;
    max-width: 62ch;
    margin-bottom: 28px;
  }
  .sec-head p {
    color: var(--ink-2);
  }

  .teams,
  .first {
    padding-block: 48px;
    scroll-margin-top: var(--header-h);
  }

  .teams__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .team {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1.5px dashed var(--border);
    border-radius: var(--radius);
  }
  .team--ready {
    border-style: solid;
    border-color: var(--green);
    box-shadow: var(--shadow);
  }
  .team__head {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 6px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border-soft);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .team--ready .team__head {
    background: var(--green-soft);
    border-bottom-color: color-mix(in srgb, var(--green) 35%, transparent);
  }
  .team__handle {
    color: var(--ink);
    font-weight: 700;
  }
  .team__status {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .team__status::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    vertical-align: 0.05em;
  }
  .team__status--ready {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 7px 1px 5px;
    border-radius: 3px;
    background: var(--green-ink);
    color: var(--on-green);
    font-weight: 600;
  }
  .team__status--ready::before {
    display: none;
  }
  .team__status--ready :global(svg) {
    stroke-width: 2.6;
  }
  .team__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 18px 20px 20px;
  }
  .team__name {
    font-size: 1.4rem;
  }
  .team__text {
    color: var(--ink-2);
    font-size: 0.975rem;
    line-height: 1.55;
  }
  .team__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: auto;
    padding-top: 10px;
  }
  .team__more {
    font-weight: 600;
  }
  .team__soon {
    font-size: 0.925rem;
    color: var(--ink-3);
  }

  .first__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 32px 56px;
    align-items: start;
  }
  .first__side {
    display: grid;
    gap: 16px;
  }
  .path {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .path__step {
    position: relative;
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 16px;
    padding-bottom: 28px;
  }
  .path__step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 30px;
    top: 30px;
    bottom: 4px;
    width: 2px;
    background: color-mix(in srgb, var(--green) 45%, transparent);
  }
  .path__n {
    align-self: start;
    justify-self: start;
    padding: 2px 8px;
    border: 1.5px solid var(--green);
    border-radius: 3px;
    background: var(--surface);
    color: var(--green-ink);
    font-weight: 700;
    white-space: nowrap;
  }
  .path__body {
    display: grid;
    gap: 6px;
  }
  .path__title {
    font-size: 1.15rem;
  }
  .path__text {
    color: var(--ink-2);
  }
  .path__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
    font-weight: 600;
  }
  .bigmap p + p {
    margin-top: 4px;
  }

  @media (max-width: 900px) {
    .hero,
    .first__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .teams__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .path__step {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding-left: 0;
    }
    .path__step:not(:last-child)::before {
      display: none;
    }
  }
</style>
