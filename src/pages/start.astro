---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getPhases, href, phaseHref } from '../lib/site';

type Option = { label: string; next?: string; result?: number; note?: string };
type Question = { id: string; text: string; help?: string; options: Option[] };

const questions: Question[] = [
  {
    id: 'q1',
    text: 'Πόσο κώδικα έχεις γράψει μέχρι τώρα;',
    options: [
      { label: 'Καθόλου', result: 0, note: 'Κάνε και το προαιρετικό Learn JavaScript της Φάσης 0. Θα το χρειαστείς αργότερα.' },
      { label: 'Λίγο, αλλά όχι JavaScript', result: 0, note: 'Κάνε και το Learn JavaScript της Φάσης 0. Θα το χρειαστείς στις Φάσεις 3 και 4.' },
      { label: 'Ξέρω JavaScript (functions, arrays, objects)', next: 'q2' },
    ],
  },
  {
    id: 'q2',
    text: 'Μπορείς να εξηγήσεις τι είναι blockchain, transaction, wallet και gas;',
    options: [
      { label: 'Όχι ακόμα, ή μόνο λίγο', result: 1, note: 'Βεβαιώσου ότι έχεις GitHub και ένα wallet μόνο για testnets (Φάση 0).' },
      { label: 'Ναι, με δικά μου λόγια', next: 'q3' },
    ],
  },
  {
    id: 'q3',
    text: 'Έχεις γράψει Solidity;',
    options: [
      { label: 'Όχι', result: 2, note: 'Αν σε ενδιαφέρει τι γίνεται «από κάτω», ξεκίνα παράλληλα και τη Φάση 3.' },
      { label: 'Ναι, απλά contracts', next: 'q4' },
    ],
  },
  {
    id: 'q4',
    text: 'Έχεις φτιάξει και ανεβάσει σε testnet ένα dApp (contract και front-end);',
    options: [
      { label: 'Όχι', result: 4, note: 'Αν δεν έχεις κάνει τη Φάση 3, κάν’ τη παράλληλα. Θα σε βοηθήσει πολύ στο security.' },
      { label: 'Ναι', result: 5, note: 'Ρίξε μια ματιά στις ερωτήσεις «Πριν προχωρήσεις» των Φάσεων 2 έως 4. Αν κάπου κολλάς, γύρνα πίσω.' },
    ],
  },
];

const phases = await getPhases();
const titles = Object.fromEntries(phases.map((p) => [p.data.order, p.data.title]));
const payload = { questions, titles, phaseBase: href('phases/__N__/') };
---

<Base title="Από πού ξεκινάω;" description="Τέσσερις γρήγορες ερωτήσεις για να βρεις από ποια φάση του οδηγού να ξεκινήσεις.">
  <div class="wrap wrap--narrow page">
    <header class="st-head">
      <h1>Από πού ξεκινάω;</h1>
      <p class="st-lead">
        Μέχρι τέσσερις ερωτήσεις. Απάντα με ειλικρίνεια: αν ξεκινήσεις πιο μπροστά απ’ όσο πρέπει, θα κολλήσεις. Μπορείς πάντα να
        γυρίσεις σε προηγούμενη φάση.
      </p>
    </header>

    <form class="quiz" data-quiz novalidate>
      {
        questions.map((q, i) => (
          <fieldset class="q" data-q={q.id} hidden={i > 0}>
            <legend class="q__legend">
              <span class="addr q__num">Ερώτηση {i + 1}</span>
              <span class="q__text">{q.text}</span>
            </legend>
            <div class="q__options">
              {q.options.map((o, j) => (
                <label class="opt">
                  <input type="radio" name={q.id} value={String(j)} />
                  <span class="opt__dot" aria-hidden="true" />
                  <span class="opt__label">{o.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }

      <div class="result" data-result hidden tabindex="-1" aria-live="polite">
        <div class="result__head">
          <span class="addr result__addr" data-result-addr></span>
          <span class="tag tag--here">ξεκίνα εδώ</span>
        </div>
        <div class="result__body">
          <h2 class="result__title" data-result-title></h2>
          <p class="result__note" data-result-note></p>
          <div class="result__cta">
            <a class="btn" href="#" data-result-link>
              <span data-result-link-label>Πήγαινε στη φάση</span>
              <Icon name="arrow-right" size={18} />
            </a>
            <button class="btn btn--ghost" type="button" data-restart>Από την αρχή</button>
          </div>
          <p class="result__saved">Το σημειώσαμε: στο <a href={href('roadmap/')}>roadmap</a> αυτή η φάση θα φαίνεται με κίτρινο.</p>
        </div>
      </div>
    </form>

    <noscript>
      <p class="callout">Το quiz θέλει JavaScript. Αν δεν έχεις γράψει κώδικα, ξεκίνα από τη <a href={phaseHref(0)}>Φάση 0</a>. Αλλιώς δες το <a href={href('roadmap/')}>roadmap</a>.</p>
    </noscript>

    <aside class="callout callout--warn safety" aria-label="Κανόνες ασφαλείας">
      <Icon name="warning" size={20} />
      <div>
        <p><strong>Οι κανόνες ασφαλείας της Φάσης 0 ισχύουν για όλους, όποια φάση κι αν σου βγει.</strong></p>
        <p>Μόνο testnets, ποτέ πραγματικά χρήματα. Ποτέ private key ή seed phrase σε κώδικα, σε repo ή σε site.</p>
      </div>
    </aside>

    <script type="application/json" id="quiz-data" set:html={JSON.stringify(payload)} />
  </div>
</Base>

<script>
  import { setStart } from '../scripts/progress';

  type Option = { label: string; next?: string; result?: number; note?: string };
  type Question = { id: string; text: string; options: Option[] };
  const data: { questions: Question[]; titles: Record<string, string>; phaseBase: string } = JSON.parse(
    document.getElementById('quiz-data')!.textContent!,
  );

  const form = document.querySelector<HTMLFormElement>('[data-quiz]')!;
  const result = form.querySelector<HTMLElement>('[data-result]')!;
  const sets = new Map(data.questions.map((q) => [q.id, form.querySelector<HTMLFieldSetElement>(`[data-q="${q.id}"]`)!]));

  const pad = (n: number) => `block #${n}`;

  function update(focusNext: boolean) {
    let id: string | undefined = data.questions[0].id;
    const visible = new Set<string>();
    let outcome: Option | undefined;
    let lastShown: HTMLFieldSetElement | undefined;

    while (id) {
      visible.add(id);
      const q = data.questions.find((x) => x.id === id)!;
      const checked: HTMLInputElement | null = form.querySelector<HTMLInputElement>(`input[name="${id}"]:checked`);
      lastShown = sets.get(id);
      if (!checked) break;
      const option: Option = q.options[Number(checked.value)];
      if (option.result !== undefined) {
        outcome = option;
        break;
      }
      id = option.next;
    }

    sets.forEach((fs, qid) => {
      const show = visible.has(qid);
      fs.hidden = !show;
      if (!show) fs.querySelectorAll('input').forEach((i) => (i.checked = false));
    });

    if (outcome && outcome.result !== undefined) {
      const n = outcome.result;
      result.hidden = false;
      result.querySelector('[data-result-addr]')!.textContent = pad(n);
      result.querySelector('[data-result-title]')!.textContent = `Φάση ${n}: ${data.titles[n]}`;
      result.querySelector('[data-result-note]')!.textContent = outcome.note ?? '';
      const link = result.querySelector<HTMLAnchorElement>('[data-result-link]')!;
      link.href = data.phaseBase.replace('__N__', String(n));
      link.querySelector('[data-result-link-label]')!.textContent = `Πήγαινε στη Φάση ${n}`;
      setStart(n);
      if (focusNext) result.focus();
    } else {
      result.hidden = true;
      if (focusNext && lastShown) lastShown.querySelector<HTMLInputElement>('input')?.focus();
    }
  }

  form.addEventListener('change', () => update(true));
  form.querySelector('[data-restart]')!.addEventListener('click', () => {
    form.reset();
    update(false);
    form.querySelector<HTMLInputElement>('input')?.focus();
  });
  update(false);
</script>

<style>
  .page {
    padding-top: 48px;
  }
  .st-lead {
    margin-top: 12px;
    color: var(--ink-2);
  }
  .quiz {
    display: grid;
    gap: 0;
    margin-top: 32px;
  }
  .q {
    position: relative;
    margin: 0;
    padding: 18px 20px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    min-width: 0;
  }
  .q + .q,
  .q + .result {
    margin-top: 44px;
  }
  .q:not([hidden]) + .q:not([hidden])::before,
  .q:not([hidden]) + .result:not([hidden])::before {
    content: '';
    position: absolute;
    left: calc(50% - 1px);
    top: -45px;
    height: 36px;
    width: 2px;
    background: var(--green);
  }
  .q:not([hidden]) + .q:not([hidden])::after,
  .q:not([hidden]) + .result:not([hidden])::after {
    content: '';
    position: absolute;
    left: calc(50% - 6px);
    top: -10px;
    width: 12px;
    height: 8px;
    background: var(--green);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .q[hidden],
  .result[hidden] {
    display: none;
  }
  .q__legend {
    float: left;
    width: 100%;
    display: grid;
    gap: 4px;
    padding: 0;
    margin-bottom: 14px;
  }
  .q__legend + * {
    clear: both;
  }
  .q__text {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .q__options {
    display: grid;
    gap: 8px;
  }
  .opt {
    position: relative;
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: center;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--surface-2);
    cursor: pointer;
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      transform 140ms var(--ease-out);
    user-select: none;
    -webkit-user-select: none;
  }
  .opt:active {
    transform: scale(0.985);
  }
  .opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .opt__dot {
    width: 20px;
    height: 20px;
    border: 2px solid var(--ink-3);
    border-radius: 50%;
    background: var(--surface);
    transition: box-shadow 140ms ease;
  }
  .opt:has(input:checked) {
    border-color: var(--ink);
    background: var(--surface);
  }
  .opt input:checked ~ .opt__dot {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 4px var(--surface), inset 0 0 0 10px var(--ink);
  }
  .opt:has(input:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .opt:hover {
      border-color: var(--ink-3);
    }
  }

  .result {
    position: relative;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow:
      0 0 0 3px var(--yellow),
      var(--shadow);
  }
  .result:focus {
    outline: none;
  }
  .result:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 6px;
  }
  .result__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 20px;
    background: var(--yellow);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .result__addr {
    color: var(--on-yellow);
    font-weight: 700;
  }
  .result__head .tag {
    background: var(--on-yellow);
    color: var(--yellow);
  }
  .result__body {
    display: grid;
    gap: 12px;
    padding: 18px 20px 20px;
  }
  .result__title {
    font-size: 1.5rem;
  }
  .result__note {
    color: var(--ink-2);
  }
  .result__note:empty {
    display: none;
  }
  .result__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }
  .result__saved {
    font-size: 0.9rem;
    color: var(--ink-3);
  }
  .safety {
    margin-top: 40px;
  }
  .safety p + p {
    margin-top: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .q:not([hidden]),
    .result:not([hidden]) {
      transition:
        opacity 220ms var(--ease-out),
        translate 220ms var(--ease-out);
      @starting-style {
        opacity: 0;
        translate: 0 6px;
      }
    }
  }
</style>
